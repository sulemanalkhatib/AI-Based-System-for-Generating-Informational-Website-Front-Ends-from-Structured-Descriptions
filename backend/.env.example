# Copy this file to ".env" and fill in your own values.
# The real .env is git-ignored and never committed.

# Your API key for an OpenAI-compatible provider (e.g. OpenRouter).
OPENROUTER_API_KEY=sk-your-key-here

# Optional: override the API base URL (any OpenAI-compatible endpoint).
# Defaults to https://openrouter.ai/api/v1 if omitted.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
